#!/bin/bash

VPN_DIR="$HOME/Script/vpn-config"
CONFIG_FILE="$HOME/.openvpn-config"
LOG_FILE="$HOME/openvpn.log"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

if pgrep -f "openvpn.*proton" > /dev/null; then
    sudo pkill -f "openvpn" 2>/dev/null
    sleep 2
    rm -f "$CONFIG_FILE"
    echo -e "Disconnecting..."
    exit 0
fi

ALL_CONFIGS=($(find "$VPN_DIR" -name "*.ovpn"))
if [ -f "$CONFIG_FILE" ] && [ ${#ALL_CONFIGS[@]} -gt 1 ]; then
    PREV=$(cat "$CONFIG_FILE")
    CONFIG=$(shuf -e "${ALL_CONFIGS[@]}" | grep -v "$PREV" | head -1)
    [ -z "$CONFIG" ] && CONFIG="$PREV"
else
    CONFIG=$(shuf -n 1 -e "${ALL_CONFIGS[@]}")
fi

echo "$CONFIG" > "$CONFIG_FILE"
SERVER=$(basename "$CONFIG" | sed 's/\.protonvpn\.udp\.ovpn//')

AUTH_FILE="$HOME/Script/vpn-config/auth.txt"
[ ! -f "$AUTH_FILE" ] && { echo -e "${RED}auth.txt missing${NC}"; exit 1; }

sudo openvpn --config "$CONFIG" --auth-user-pass "$AUTH_FILE" --daemon --log "$LOG_FILE"

sleep 3
if pgrep -f "openvpn.*proton" > /dev/null; then
    echo -e "Connecting..."
else
    echo -e "${RED}[ERROR]${NC} Failed. Check $LOG_FILE"
    sudo tail -5 "$LOG_FILE"
    rm -f "$CONFIG_FILE"
fi
